# Copy to .env and supply local secrets. Never commit the completed .env.
PORT=3500
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Required for password recovery. Without these, login still works but recovery
# reports that email delivery has not been configured. Never log or display OTPs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
