# Copy to .env and supply local secrets. Never commit the completed .env.
PORT=3500
NODE_ENV=development
# MySQL connection string (update for your server)
DATABASE_URL="mysql://yourusername:yourpassword@localhost:3306/prms_db"
MYSQL_SSL=false
# For a hosted database that requires a private CA certificate:
MYSQL_SSL_CA=
# Optional trusted MySQL server public-key file for password authentication without TLS.
MYSQL_RSA_PUBLIC_KEY=

# Must match the frontend VITE_FIREBASE_AUTH_DOMAIN (hostname only).
FIREBASE_AUTH_DOMAIN=project-prms-149c6.firebaseapp.com
# Must match the frontend Firebase project. Verification is required for Google sign-in.
FIREBASE_PROJECT_ID=your-firebase-project-id
ENABLE_FIREBASE_VERIFY=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Required for password recovery. Without these, login still works but recovery
# reports that email delivery has not been configured. Never log or display OTPs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
