# Copy this file to .env and fill in as needed, then restart the dev server.

# Required for local dev. The backend and frontend run on different ports
# (3500 vs 5173), so without this the app silently calls itself instead of
# the backend (getApiBaseUrl() falls back to window.location.origin) and
# every request fails with a generic "Server error".
VITE_API_BASE_URL=http://localhost:3500

# Optional — Google Sign-In (Firebase). firebase.js already has working
# fallback values for the shared dev Firebase project, so these are only
# needed if you're pointing at a different Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
